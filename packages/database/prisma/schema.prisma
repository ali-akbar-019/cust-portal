// CUST University Portal — Prisma Schema
// MySQL (XAMPP for local dev) + Prisma ORM (type-safe end to end with the NestJS backend)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// AUTH / USERS
// ─────────────────────────────────────────────────────────────

enum Role {
  STUDENT
  TEACHER
  ADMIN
  LIBRARIAN
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  role         Role
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  student      Student?
  teacher      Teacher?
  admin        Admin?
  librarian    Librarian?
  announcements Announcement[]
}

model Admin {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])
}

model Librarian {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])
}

// ─────────────────────────────────────────────────────────────
// ACADEMIC STRUCTURE
// ─────────────────────────────────────────────────────────────

model Department {
  id            String   @id @default(uuid())
  name          String   @unique // e.g. "Software Engineering", "Electrical Engineering"
  code          String   @unique // e.g. "SE", "EE"
  // Default class-timing window for this department (used by the generator
  // as a preference, not a hard rule — admin can override per section)
  dayStartTime  String?  // e.g. "08:00"
  dayEndTime    String?  // e.g. "16:00"

  teachers      Teacher[]
  students      Student[]
  courses       Course[]
  enrollmentSchedules EnrollmentSchedule[]
}

model Student {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  enrollmentNo String   @unique // e.g. BSE233016
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  semester     Int
  // NOTE: this is a single "primary section" (used for the early
  // Timetable Engine chunk before Enrollment existed). The real,
  // multi-course enrollment tracking is the Enrollment model below —
  // seat counts, self-enrollment, and withdrawal all go through Enrollment,
  // not this field. TODO: reconcile these two — likely deprecate this field
  // once every timetable/attendance query is migrated to read through
  // Enrollment instead.
  sectionId    String?
  section      Section?  @relation(fields: [sectionId], references: [id])

  submissions   Submission[]
  attendances   Attendance[]
  grades        Grade[]
  enrollments   Enrollment[]
  bookReservations   BookReservation[]
  libraryClearances  LibraryClearance[]
  invoices           Invoice[]
  complaints         Complaint[]
  requests           Request[]
  feedback           Feedback[]
}

model Teacher {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  designation  String?  // e.g. "Lecturer", "Assistant Professor"

  sections     Section[]
}

model Course {
  id           String   @id @default(uuid())
  code         String   @unique // e.g. "SE4103"
  title        String
  creditHours  Int
  requiresLab  Boolean  @default(false) // drives room-type matching in the generator
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  sections     Section[]
}

// A Section = one specific offering of a Course for a batch/term,
// taught by one teacher, with its own timetable slots and roster.
model Section {
  id           String   @id @default(uuid())
  courseId     String
  course       Course   @relation(fields: [courseId], references: [id])
  teacherId    String
  teacher      Teacher  @relation(fields: [teacherId], references: [id])
  term         String   // e.g. "Fall 2026"
  capacity     Int      @default(40)

  students        Student[]
  slots           TimetableSlot[]
  assignments     Assignment[]
  attendanceDays  Attendance[]
  enrollments     Enrollment[]
  feedback        Feedback[]
}

model Enrollment {
  id         String   @id @default(uuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id])
  sectionId  String
  section    Section  @relation(fields: [sectionId], references: [id])
  status     String   @default("ACTIVE") // ACTIVE | WITHDRAWN | COMPLETED
  enrolledAt DateTime @default(now())

  @@unique([studentId, sectionId])
}

// Admin-defined window during which students may self-enroll for a term.
// Scoped per department since different departments may open enrollment
// on different dates (mirrors Tasjeel's "Enrollment Schedules" feature).
model EnrollmentSchedule {
  id           String   @id @default(uuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  term         String   // e.g. "Fall 2026"
  startsAt     DateTime
  endsAt       DateTime

  @@index([departmentId, startsAt, endsAt])
}

// ─────────────────────────────────────────────────────────────
// CAMPUS / ROOMS (Blocks -> Floors -> Rooms)
// ─────────────────────────────────────────────────────────────

model Block {
  id     String  @id @default(uuid())
  name   String  @unique // "A","B","C","D","E","F","H","J","K"
  floors Floor[]
}

model Floor {
  id          String @id @default(uuid())
  blockId     String
  block       Block  @relation(fields: [blockId], references: [id])
  floorNumber Int    // 0 = ground floor, 1, 2, 3...
  rooms       Room[]

  @@unique([blockId, floorNumber])
}

enum RoomType {
  LECTURE_HALL
  LAB
  SEMINAR_ROOM
}

model Room {
  id         String   @id @default(uuid())
  floorId    String
  floor      Floor    @relation(fields: [floorId], references: [id])
  label      String   // "B1", "B2"... unique within a block, matches CUST's room naming
  capacity   Int
  type       RoomType @default(LECTURE_HALL)

  slots      TimetableSlot[]

  @@unique([floorId, label])
}

// ─────────────────────────────────────────────────────────────
// TIMETABLE
// ─────────────────────────────────────────────────────────────

enum Weekday {
  MON
  TUE
  WED
  THU
  FRI
  SAT
}

model TimetableSlot {
  id        String  @id @default(uuid())
  sectionId String
  section   Section @relation(fields: [sectionId], references: [id])
  roomId    String
  room      Room    @relation(fields: [roomId], references: [id])
  day       Weekday
  startTime String  // "09:00" (24h) — stored as string, compared as minutes in app logic
  endTime   String  // "10:30"

  // Note: true overlap-prevention (same room/teacher/section clashing in
  // time) is enforced in the TimetableService, not by a DB constraint —
  // neither MySQL nor Postgres can express "no overlapping time ranges"
  // as a plain unique/check constraint without extra tooling (Postgres has
  // btree_gist + EXCLUDE, MySQL has no equivalent at all). Application-level
  // checkClash() is the actual mechanism and is DB-agnostic either way.
  @@index([day, roomId])
  @@index([day, sectionId])
}

// ─────────────────────────────────────────────────────────────
// ASSIGNMENTS / SUBMISSIONS
// ─────────────────────────────────────────────────────────────

model Assignment {
  id          String   @id @default(uuid())
  sectionId   String
  section     Section  @relation(fields: [sectionId], references: [id])
  title       String
  description String?
  deadline    DateTime
  fileUrl     String?  // instructions/attachment on R2
  createdAt   DateTime @default(now())

  submissions Submission[]
}

model Submission {
  id           String    @id @default(uuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  studentId    String
  student      Student   @relation(fields: [studentId], references: [id])
  fileUrl      String
  submittedAt  DateTime  @default(now())
  grade        Float?
  feedback     String?

  @@unique([assignmentId, studentId])
}

// ─────────────────────────────────────────────────────────────
// ATTENDANCE
// ─────────────────────────────────────────────────────────────

enum AttendanceStatus {
  PRESENT
  ABSENT
}

model Attendance {
  id        String           @id @default(uuid())
  sectionId String
  section   Section          @relation(fields: [sectionId], references: [id])
  studentId String
  student   Student          @relation(fields: [studentId], references: [id])
  date      DateTime
  status    AttendanceStatus

  @@unique([sectionId, studentId, date])
}

// ─────────────────────────────────────────────────────────────
// LIBRARY
// ─────────────────────────────────────────────────────────────

model Book {
  id               String   @id @default(uuid())
  title            String
  author           String
  isbn             String   @unique
  totalCopies      Int
  availableCopies  Int

  reservations     BookReservation[]
}

enum ReservationStatus {
  PENDING
  FULFILLED
  CANCELLED
}

model BookReservation {
  id          String            @id @default(uuid())
  bookId      String
  book        Book              @relation(fields: [bookId], references: [id])
  studentId   String
  student     Student           @relation(fields: [studentId], references: [id])
  status      ReservationStatus @default(PENDING)
  reservedAt  DateTime          @default(now())

  @@unique([bookId, studentId, status]) // prevents duplicate pending reservations of the same book
}

enum ClearanceStatus {
  PENDING
  APPROVED
  REJECTED
}

model LibraryClearance {
  id           String          @id @default(uuid())
  studentId    String
  student      Student         @relation(fields: [studentId], references: [id])
  status       ClearanceStatus @default(PENDING)
  remarks      String?
  requestedAt  DateTime        @default(now())
  resolvedAt   DateTime?

  @@unique([studentId, status]) // a student can't have two PENDING requests at once
}

// ─────────────────────────────────────────────────────────────
// INVOICES
// ─────────────────────────────────────────────────────────────

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
}

model Invoice {
  id          String        @id @default(uuid())
  studentId   String
  student     Student       @relation(fields: [studentId], references: [id])
  description String
  amount      Float
  dueDate     DateTime
  status      InvoiceStatus @default(PENDING)
  issuedAt    DateTime      @default(now())
  paidAt      DateTime?

  @@index([studentId, status])
}

// ─────────────────────────────────────────────────────────────
// COMPLAINTS
// ─────────────────────────────────────────────────────────────

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model Complaint {
  id          String          @id @default(uuid())
  studentId   String
  student     Student         @relation(fields: [studentId], references: [id])
  subject     String
  description String          @db.Text
  status      ComplaintStatus @default(OPEN)
  response    String?         @db.Text
  createdAt   DateTime        @default(now())
  resolvedAt  DateTime?

  @@index([status])
}

// ─────────────────────────────────────────────────────────────
// REQUESTS (transcripts, letters, course withdraw, info change, general)
// ─────────────────────────────────────────────────────────────

enum RequestType {
  TRANSCRIPT
  LETTER
  COURSE_WITHDRAW
  PERSONAL_INFO_CHANGE
  GENERAL
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model Request {
  id           String        @id @default(uuid())
  studentId    String
  student      Student       @relation(fields: [studentId], references: [id])
  type         RequestType
  details      String        @db.Text // free-text specifics (e.g. which letter, what info to change)
  sectionId    String?       // only set for COURSE_WITHDRAW — the section being dropped
  status       RequestStatus @default(PENDING)
  adminRemarks String?
  createdAt    DateTime      @default(now())
  resolvedAt   DateTime?

  @@index([status, type])
}

// ─────────────────────────────────────────────────────────────
// FEEDBACK (QA Feedback — students rate a section/teacher)
// ─────────────────────────────────────────────────────────────

model Feedback {
  id          String   @id @default(uuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  sectionId   String
  section     Section  @relation(fields: [sectionId], references: [id])
  rating      Int      // 1-5
  comments    String?  @db.Text
  submittedAt DateTime @default(now())

  @@unique([studentId, sectionId]) // one feedback per student per section
}

// ─────────────────────────────────────────────────────────────
// GRADES
// ─────────────────────────────────────────────────────────────

model Grade {
  id        String  @id @default(uuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id])
  courseId  String
  component String  // "quiz1", "midterm", "final"
  marks     Float
  maxMarks  Float

  @@unique([studentId, courseId, component])
}

// ─────────────────────────────────────────────────────────────
// ANNOUNCEMENTS
// ─────────────────────────────────────────────────────────────

enum AnnouncementTarget {
  ALL
  DEPARTMENT
  SECTION
}

model Announcement {
  id           String             @id @default(uuid())
  postedById   String
  postedBy     User               @relation(fields: [postedById], references: [id])
  title        String
  message      String             @db.Text
  target       AnnouncementTarget
  departmentId String? // set when target = DEPARTMENT
  sectionId    String? // set when target = SECTION
  createdAt    DateTime           @default(now())

  @@index([target, departmentId])
  @@index([target, sectionId])
}
