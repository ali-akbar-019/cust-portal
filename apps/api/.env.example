# Copy this to .env and fill in real values. Never commit .env itself.

# XAMPP default MySQL: user "root", no password, port 3306.
# Create the "cust_portal" database first via phpMyAdmin (or the mysql CLI),
# then Prisma migrate will create all the tables inside it.
DATABASE_URL="mysql://root:@localhost:3306/cust_portal"

JWT_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"

PORT=4000
